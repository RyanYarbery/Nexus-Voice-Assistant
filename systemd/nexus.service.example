[Unit]
Description=Nexus Voice Assistant
Wants=network-online.target
After=network-online.target sound.target

[Service]
Type=simple
User=YOUR_USER
Group=YOUR_USER
WorkingDirectory=/home/YOUR_USER/nexus-voice-assistant

Environment=HOME=/home/YOUR_USER
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/YOUR_USER/.config/nexus/env

ExecStartPre=/bin/sleep 5
ExecStart=/home/YOUR_USER/nexus-voice-assistant/.venv/bin/python /home/YOUR_USER/nexus-voice-assistant/echo.py

Restart=always
RestartSec=5
TimeoutStopSec=10
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
