# Nexus settings. Copy to ~/.config/nexus/env (chmod 600) and edit.
# Every setting is listed in docs/SETTINGS.md; `python -m nexus doctor`
# checks this file's effect and points out names nothing reads.

# Required for NEXUS_BACKEND=openai. Usage is billed by OpenAI.
OPENAI_API_KEY=replace_with_your_api_key

# ---- Which parts to use ---------------------------------------------------
# Microphone and speaker: generic (any sound card) | xvf3800 | module:Class
NEXUS_AUDIO=generic
# Wake word: openwakeword | module:Class
NEXUS_WAKE=openwakeword
# Voice check: none (answer anyone) | ecapa | module:Class
NEXUS_SPEAKER_ID=none
# Voice service: openai | module:Class
NEXUS_BACKEND=openai

# ---- Where things are -----------------------------------------------------
NEXUS_HOME=/home/your-user/nexus-voice-assistant
# Part of each device's name as `python -m sounddevice` lists it; leave
# empty for the system default.
NEXUS_MIC_NAME=
NEXUS_SPEAKER_NAME=
# Your wake-word model. Never commit it.
NEXUS_WAKE_MODEL_PATH=/home/your-user/nexus-voice-assistant/models/hey_nexus.onnx
NEXUS_WAKE_PHRASE=Hey Nexus

# ---- Tuning ---------------------------------------------------------------
# Score (0 to 1) at which the wake word fires. openWakeWord models are
# trained for 0.5; lower catches more and wakes by mistake more.
NEXUS_WAKE_THRESHOLD=0.10
# Personality: plain | sardonic | your own file via NEXUS_INSTRUCTIONS_FILE
NEXUS_PERSONA=plain

# ---- Hearing about problems ----------------------------------------------
# A push message to your phone when Nexus stops working or recovers.
# The address works like a password: keep it private.
# NEXUS_NTFY_URL=https://ntfy.sh/your-private-topic

# ---- Only for NEXUS_AUDIO=xvf3800 ----------------------------------------
# NEXUS_MIC_NAME=respeaker xvf3800
# NEXUS_AEC_REFERENCE_NAME=respeaker xvf3800
# NEXUS_RESPEAKER_ROUTE_HELPER=/usr/local/bin/nexus-respeaker-route

# ---- Only for NEXUS_SPEAKER_ID=ecapa -------------------------------------
# Voice profiles are personal. Never commit them.
# NEXUS_VOICE_PROFILE_CH0=/home/your-user/nexus-voice-assistant/models/voice_ch0.pt
# NEXUS_VOICE_PROFILE_CH1=/home/your-user/nexus-voice-assistant/models/voice_ch1.pt
# soft (check beside the request) | strict (check before anything is sent)
# NEXUS_SPEAKER_VERIFY_MODE=soft
