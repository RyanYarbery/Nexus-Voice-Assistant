# Required
OPENAI_API_KEY=replace_with_your_api_key

# Optional overrides
OPENAI_REALTIME_MODEL=gpt-realtime
NEXUS_HOME=/home/your-user/nexus-voice-assistant
NEXUS_MIC_NAME=respeaker xvf3800
NEXUS_SPEAKER_NAME=alc3234 analog
# Output endpoint fed with a silent copy of playback as the hardware
# echo-cancellation reference. Defaults to NEXUS_MIC_NAME. Set to "off"
# for microphones without a playback endpoint.
NEXUS_AEC_REFERENCE_NAME=respeaker xvf3800
# Keep one reference stream open for the life of the process so the
# XVF3800 never re-locks its clock or re-converges its canceller at the
# start of a reply. 0 opens a stream per reply instead.
NEXUS_AEC_REFERENCE_CONTINUOUS=1

# Start speaking as soon as the first audio arrives and cancel the
# server's reply on barge-in. 0 restores whole-reply buffering.
NEXUS_STREAMING_PLAYBACK=1

# soft   stream immediately, verify the speaker in parallel (default)
# strict hold the request until 1.2 s of audio has been verified
# off    no speaker verification
NEXUS_SPEAKER_VERIFY_MODE=soft

# Per-block score logging for threshold tuning (noisy in journald)
NEXUS_WAKE_DEBUG=0
NEXUS_BARGE_DEBUG=0
NEXUS_HTTP_USER_AGENT=NexusHouseholdAssistant/1.0 (contact@example.com)

# Private model paths. Never commit the referenced files.
NEXUS_WAKE_MODEL_PATH=/home/your-user/nexus-voice-assistant/models/hey_nexus.onnx
NEXUS_VOICE_PROFILE_CH0=/home/your-user/nexus-voice-assistant/models/voice_ch0.pt
NEXUS_VOICE_PROFILE_CH1=/home/your-user/nexus-voice-assistant/models/voice_ch1.pt
NEXUS_SPEAKER_MODEL_CACHE=/home/your-user/nexus-voice-assistant/models/spkrec-ecapa-voxceleb

# Optional local state paths (default: alongside echo.py)
# NEXUS_ALARMS_FILE=/home/your-user/nexus-voice-assistant/alarms.json
# NEXUS_TIMERS_FILE=/home/your-user/nexus-voice-assistant/timers.json
# NEXUS_SETTINGS_FILE=/home/your-user/nexus-voice-assistant/settings.json

# Optional hardware-specific routing helper
NEXUS_RESPEAKER_ROUTE_HELPER=/usr/local/bin/nexus-respeaker-route
